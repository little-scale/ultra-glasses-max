{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Apple silicon release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MAX_SDK_PACKAGE_OUT_OF_TREE": "ON",
        "MAX_SDK_BASE_PATH": "$env{MAX_SDK_BASE_PATH}",
        "VITURE_SDK_ROOT": "$env{VITURE_SDK_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
